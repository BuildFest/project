# Copy to .env for local dev. On Railway, set these as service variables.

# Railway: reference the Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pitcrew

# Required. 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Paste the same value into the repo's GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=

# Required in production: the service's public https URL (no trailing slash).
# Used to build the webhook URL returned by POST /projects/:id/repositories.
PUBLIC_BASE_URL=

# Fine-grained PAT with Metadata + Contents + Pull requests read on the repo.
# Optional for public repos, required for private ones (BuildFest/project is private).
GITHUB_TOKEN=

# The frontend's origin.
CORS_ORIGIN=http://localhost:3000

# AI models. Optional: without keys, AI features switch off and rules still run.
# Fast tier handles cheap jobs (link suggestions, diff summaries); smart tier
# handles reasoning (pre-merge notes, replans, digest, questions).
# Providers: groq | openai | openrouter | anthropic
AI_FAST_PROVIDER=groq
AI_FAST_MODEL=llama-3.3-70b-versatile
AI_SMART_PROVIDER=anthropic
AI_SMART_MODEL=claude-sonnet-5
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Move a job between tiers, e.g. AI_JOB_DIFF_SUMMARY=smart
# Tokens per day across all jobs; 0 disables the cap.
AI_DAILY_TOKEN_BUDGET=2000000
